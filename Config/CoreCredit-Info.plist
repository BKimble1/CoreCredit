<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Partial Info.plist for the CoreCredit app target.

	  GENERATE_INFOPLIST_FILE stays YES; Xcode merges every INFOPLIST_KEY_* build
	  setting on top of this file. Only keys that have no INFOPLIST_KEY_ equivalent
	  belong here — the URL scheme, because CFBundleURLTypes is an array of
	  dictionaries, and the launch screen, because UILaunchScreen is a dictionary.

	  The scheme must stay in step with AppConfiguration.urlScheme.

	  UILaunchScreen is the screen iOS paints the instant the process starts, before
	  a single line of SwiftUI runs. It is what stops the app opening on a white
	  flash. It takes a colour and an image and nothing else — no gradient, no
	  layout — so the gradient version of the same picture is LaunchSplashView,
	  which fades in over this one and then fades away.

	  INFOPLIST_KEY_UILaunchScreen_Generation must stay OFF in the build settings.
	  It generates an empty UILaunchScreen dictionary, and a generated key is merged
	  on top of this file — it would silently replace everything below with nothing.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<!-- The flat brand blue. It is the midpoint of LaunchSplashView's gradient,
		     so the handover from this screen to that one reads as the light coming
		     up rather than as one picture replacing another. -->
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<!-- The white mark on a transparent canvas, with the "Powered by Idlery"
		     credit drawn into the padding beneath it. The canvas is taller than
		     it is wide and the padding is split evenly above and below, so iOS —
		     which centres this image at its natural size — leaves the mark
		     exactly where it has always been. Generated by
		     scripts/render_launch_mark.py; do not crop it by hand. -->
		<key>UIImageName</key>
		<string>LaunchMark</string>
	</dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.blakekimble.corecredit.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>corecredit</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
