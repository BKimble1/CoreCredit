<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CoreCredit does not track users across apps or websites. -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No tracking, therefore no tracking domains. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- CoreCredit is local-first. Nothing is collected, transmitted, or linked to the user.
	     Shop data, photos, and exports stay in the app's own container on device. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Required-reason APIs actually reached by this app.
	     Each entry below is backed by a specific call in the shipped code. An entry that cannot be
	     pointed at real code is removed rather than left in "just in case": an unjustified
	     declaration is as much a misstatement as a missing one. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- File timestamps: ExportFileStore.cleanUpOldExports(olderThan:) reads
			     .contentModificationDateKey on files in the app's own caches directory to sweep
			     generated PDF/CSV/JSON exports older than 24 hours. C617.1 - timestamps of files
			     inside the app container, created by the app itself. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- User defaults: EntitlementCache stores the last-known subscription entitlement so a
			     paying shop is not locked out while offline. CA92.1 - access limited to the app
			     itself; there is no app group and no other reader. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- Deliberately absent: NSPrivacyAccessedAPICategoryDiskSpace (E174.1). A repository-wide
		     search finds no disk-space API anywhere in the app target - no volumeAvailableCapacity
		     key, no systemFreeSize, no free-space check before writing a photo or an export. The
		     entry described behaviour the code does not have, so it has been removed. If a
		     free-space check is ever added, this entry must come back in the same commit. -->
	</array>
</dict>
</plist>
