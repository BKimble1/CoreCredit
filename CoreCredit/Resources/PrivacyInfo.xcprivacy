<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CoreCredit does not track users across apps or websites. -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No tracking, therefore no tracking domains. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- CoreCredit is local-first. Nothing is collected, transmitted, or linked to the user.
	     Shop data, photos, and exports stay in the app's own container on device. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Required-reason APIs actually reached by this app and its frameworks. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- File timestamps: SwiftData's store, exported PDF/CSV/JSON files in the caches
			     directory, and the retention sweep that removes exports older than 24 hours. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- User defaults: the cached last-known subscription entitlement, so a paying shop
			     is not locked out while offline. Read and written only by this app. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<!-- Disk space: checked before writing downsampled evidence photos and generated
			     export documents, so a full device fails with a message instead of silently. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
